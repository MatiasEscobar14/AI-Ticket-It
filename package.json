{
  "name": "tp-individual",
  "version": "1.0.0",
  "private": true,
  "description": "Base monorepo para trabajos prácticos de Desarrollo de Software",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "start:backend": "npm start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:frontend": "npm start --workspace=frontend",
    "start:dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:start:frontend\"",
    "test:backend": "npm test --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend"
  },
  "keywords": [
    "fullstack",
    "express",
    "react",
    "vite",
    "tp"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
